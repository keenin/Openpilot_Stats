# Install on the Debian machine (not in the browser).
#   sudo cp cron/op-usage.cron.example /etc/cron.d/op-usage
#   sudo chmod 644 /etc/cron.d/op-usage
# Edit the user and path. Logs: /var/log/op-usage.log (create + chown)
#
# 03:00 America/Los_Angeles every night.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
CRON_TZ=America/Los_Angeles
MAILTO=""

0 3 * * * debianuser /usr/bin/flock -n /tmp/op-usage.lock /home/debianuser/Openpilot_Stats/scripts/nightly.sh >> /var/log/op-usage.log 2>&1
