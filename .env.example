# Copy to ~/.config/op-usage/credentials.env (outside this repo) and fill in.
# Never commit the real file. chmod 600 the credentials file.
#
#   mkdir -p ~/.config/op-usage ~/.cache/op-usage
#   cp .env.example ~/.config/op-usage/credentials.env
#   chmod 600 ~/.config/op-usage/credentials.env

# User JWT from https://jwt.comma.ai
# Header sent as: Authorization: JWT <token>
# TODO: jwt.comma.ai tokens expire; if a nightly run gets 401, mint a new token.
# Device-signed JWTs (openpilot private key) are NOT used by this tool.
COMMA_JWT=

# Single comma device. Connect → device → dongle id (16 hex chars, typically).
DONGLE_ID=

# Optional overrides
# COMMA_API_BASE=https://api.commadotai.com
# CACHE_PATH=~/.cache/op-usage/op-usage.sqlite
# SITE_DIR=./site
# DISPLAY_TZ=America/Los_Angeles
# BACKFILL_START=2018-01-01
# OPENPILOT_PATH=/home/you/openpilot
# CEREAL_PATH=/home/you/openpilot/cereal

# Optional. Used only to fingerprint master driving-model weights
# (GitHub contents API). Unauthenticated is 60 req/hour; cache hits skip the network.
# GITHUB_TOKEN=

# Cloudflare Pages deploy (scripts/deploy.sh)
# CF_PAGES_PROJECT=op-usage
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
